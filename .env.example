# ==========================================
# AI Interviewer Configuration
# ==========================================

# --- LiveKit Server Credentials ---
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# --- LLM Configuration (LangGraph, OpenAI-compatible provider) ---
# e.g. SiliconFlow, DeepSeek, Qwen
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
# Each graph call gets a bounded wait and a small retry budget. A hung provider
# should surface as an error, not as a candidate staring at a silent interviewer.
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# --- Voice: STT & TTS (SiliconFlow) ---
SILICONFLOW_API_KEY=your_siliconflow_api_key_here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
STT_MODEL=FunAudioLLM/SenseVoiceSmall
STT_LANGUAGE=zh
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:alex
TTS_RESPONSE_FORMAT=mp3

# --- Interview Flow Settings ---
# Default interview mode: 'quick' (short run, good for demo recordings) or
# 'real' (full-length interview). The browser can pick a mode per session; this
# value is the fallback when the page does not send one.
INTERVIEW_MODE=quick
# Set to 0 to score from the transcript only and skip delivery measurements.
DELIVERY_METRICS=1

# Offline listen bake-off. Both directories stay outside this repo.
# LISTEN_BAKEOFF_AUDIO_DIR=
# LISTEN_BAKEOFF_RECORD_DIR=

# Access-token lifetime in seconds. The browser requests a fresh token on every
# entry, so an hour is plenty; production should likely be shorter.
TOKEN_TTL_SECONDS=3600

# Question budget per phase and follow-up allowance for each mode.
QUICK_QUESTIONS_PER_PHASE=1
REAL_QUESTIONS_PER_PHASE=3
QUICK_MAX_FOLLOW_UPS=1
REAL_MAX_FOLLOW_UPS=2
QUICK_MAX_INTRO_ATTEMPTS=1
REAL_MAX_INTRO_ATTEMPTS=3

# A self-introduction shorter than this many characters is sent back once.
MIN_INTRO_CHARS=50

# Optional prompt overrides (defaults live in config.py).
# AGENT_INSTRUCTIONS=你是一名中文考研复试 AI 面试官。语气自然、专业、严谨且温和。严格按面试阶段引导考生。
# Spoken verbatim when the candidate joins. Not an instruction to the model.
# GREETING_TEXT=同学你好，欢迎参加考研复试模拟面试，请先进行1分钟左右的自我介绍。

LOG_LEVEL=INFO
